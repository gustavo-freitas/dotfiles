# ===================== Feeds & refresh =====================
# Fresh articles when you open newsboat, and every hour while it's open
refresh-on-startup  yes
auto-reload         yes
reload-time         60
reload-threads      8
cleanup-on-quit     yes

# Open links in Firefox
browser "firefox %u"

# ===================== Reading =====================
# ~80 characters per line: the comfortable range for long-form prose
text-width          80
# Keep a few lines of context above/below the cursor when scrolling
scrolloff           5
# Hide feeds with nothing unread (press l to toggle)
show-read-feeds     no
# Don't ask before marking a whole feed read (A)
confirm-mark-feed-read no
# After opening an article in the browser and marking it read (O), go to the next unread
openbrowser-and-mark-jumps-to-next-unread yes

# ===================== Lists =====================
datetime-format     "%d %b"
feedlist-format     "  %?U?%4U&    ?   %t"
articlelist-format  "  %D   %?T?%-24T  ?%-18a  %t"

# ===================== Keys (vim style) =====================
# Plain j/k/g are taken by defaults (next-feed/prev-feed/sort), so free them first
unbind-key j
unbind-key k
unbind-key J
unbind-key K
unbind-key g
unbind-key G
bind-key j  down
bind-key k  up
bind-key J  next-feed      articlelist
bind-key K  prev-feed      articlelist
bind-key J  next           article
bind-key K  prev           article
bind-key g  home
bind-key G  end
bind-key ^D halfpagedown
bind-key ^U halfpageup

# ===================== Colors (from cmus) =====================
color background          default   default
color listnormal          color246  default
color listnormal_unread   color223  default
color listfocus           color246  color237
color listfocus_unread    color223  color237
color title               color172  color237
color info                color66   color236
color hint-key            color109  color236  bold
color hint-keys-delimiter color246  color236
color hint-separator      color246  color236
color hint-description    color66   color236
color article             default   default
color end-of-text-marker  color246  default

# Article view: make the header, links and image markers easy to spot
highlight article "^(Feed|Title|Author|Date|Link|Flags|Podcast Download URL):" color109 default bold
highlight article "^Title:.*$"            color223  default  bold
highlight article "https?://[^ ]+"        color66   default  underline
highlight article "\\[[0-9]+\\]"          color172  default  bold
highlight article "\\[image [0-9]+[^]]*\\]" color246 default
